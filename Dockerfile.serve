# Day 5: serving-only image for the FastAPI /predict backend.
# Builds from requirements-serve.txt (no mlflow/kaggle/airflow deps) and
# the standalone model/ bundle (see scripts/export_champion.py) rather
# than the full mlruns/ tracking store.
FROM python:3.12-slim

WORKDIR /app

COPY requirements-serve.txt .
RUN pip install --no-cache-dir -r requirements-serve.txt

COPY src/serve.py src/serve.py
COPY model/ model/

ENV ALLOWED_ORIGINS="*"

EXPOSE 8000
CMD ["sh", "-c", "uvicorn src.serve:app --host 0.0.0.0 --port ${PORT:-8000}"]
